{
  "Name": "Mixer",
  "Description": "Volume master e volume per singola app di Windows, da manopole o tasti",
  "Author": "thecorps",
  "Version": "0.2.0",
  "Icon": "icons/plugin",
  "Category": "Mixer",
  "CategoryIcon": "icons/plugin",
  "CodePathWin": "bin/OpenDeckMixer.exe",
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "SDKVersion": 2,
  "Actions": [
    {
      "Name": "Volume master",
      "UUID": "it.thecorpscloud.mixer.master",
      "Icon": "icons/master",
      "Tooltip": "Manopola: regola il volume di Windows. Pressione: muto",
      "Controllers": ["Encoder", "Keypad"],
      "PropertyInspectorPath": "pi/pi.html",
      "SupportedInMultiActions": false,
      "States": [{ "Image": "icons/master", "TitleAlignment": "bottom" }],
      "Encoder": {
        "Icon": "icons/master",
        "TriggerDescription": { "Rotate": "Volume", "Push": "Muto" }
      }
    },
    {
      "Name": "Volume app",
      "UUID": "it.thecorpscloud.mixer.app",
      "Icon": "icons/app",
      "Tooltip": "Manopola: regola il volume di un'app (es. Discord). Pressione: muto",
      "Controllers": ["Encoder", "Keypad"],
      "PropertyInspectorPath": "pi/pi.html",
      "SupportedInMultiActions": false,
      "States": [{ "Image": "icons/app", "TitleAlignment": "bottom" }],
      "Encoder": {
        "Icon": "icons/app",
        "TriggerDescription": { "Rotate": "Volume app", "Push": "Muto app" }
      }
    }
  ]
}
